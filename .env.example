# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Backend runtime configuration
DATABASE_URL=sqlite:///./kirana.db
APP_API_KEY=replace-with-a-local-demo-key
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_ESCALATION_MODEL=gpt-5.4-mini
OPENAI_QUERY_MODEL=gpt-5.4-mini
MODEL_DIR=../models
APP_ENV=development
