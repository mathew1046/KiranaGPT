# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_AUDIO_MODEL=gpt-audio-1.5

# Backend runtime configuration
DATABASE_URL=sqlite:///./kirana.db
APP_API_KEY=replace-with-a-local-demo-key
# Comma-separated browser origins allowed to call the API. For Firebase use:
# https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com
CORS_ALLOW_ORIGINS=
OPENAI_EXTRACTION_MODEL=gpt-5.5
OPENAI_ESCALATION_MODEL=gpt-5.5
OPENAI_QUERY_MODEL=gpt-5.5
MODEL_DIR=../models
APP_ENV=development
