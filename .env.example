# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=

# Backend runtime configuration
DATABASE_URL=sqlite:///./kirana.db
APP_API_KEY=replace-with-a-local-demo-key
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_ESCALATION_MODEL=gpt-4.1
OPENAI_QUERY_MODEL=gpt-4.1-mini
MODEL_DIR=../models
APP_ENV=development
